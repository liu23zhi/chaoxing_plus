// Version resource for the stand-in IME module.
//
// Windows loads the module named by the layout's "IME file" value and queries its version
// resource while initialising the layout. A DLL without VERSIONINFO makes LoadKeyboardLayoutW
// fail with 1813 (ERROR_RESOURCE_TYPE_NOT_FOUND), so this file is part of the contract, not
// decoration.

#include <windows.h>

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "chaoxing-plus"
            VALUE "FileDescription", "ExamInput IME stub"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "cxime"
            VALUE "OriginalFilename", "cxime.ime"
            VALUE "ProductName", "ExamInput"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
