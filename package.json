{
  "name": "chaoxing-plus",
  "version": "6.2.0",
  "description": "a tool",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node build.mjs --watch",
    "build": "node build.mjs",
    "build:windows": "node windows/share-file/build.windows.mjs",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File windows/native-source/build.ps1 -BuildTests",
    "build:node:exe": "node windows/node-source/package-node-exe.mjs",
    "release:windows": "node windows/share-file/package-windows.mjs",
    "windows": "windows\\native-source\\start-windows.cmd",
    "windows:debug": "windows\\native-source\\start-windows-debug.cmd",
    "windows:silent": "windows\\native-source\\start-windows-silent.cmd",
    "windows:self-check": "windows\\native-build\\bin\\chaoxing_plus.exe --self-check",
    "windows:node": "node windows/node-source/main.mjs",
    "windows:node:self-check": "node windows/node-source/main.mjs --self-check",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/md5": "^2.3.5",
    "@types/node": "^26.6.5",
    "@typescript/typescript6": "^6.0.2",
    "pe-library": "2.0.1",
    "puppeteer": "^25.14.0",
    "resedit": "3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "md5": "^2.3.0",
    "sweetalert2": "^11.26.25",
    "typr.js": "^1.0.0"
  }
}
